<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Headers/Labels -->
  <sys:String x:Key="Label_Spacing">Spacing (px):</sys:String>
  <sys:String x:Key="Label_DisplaySet">Display set:</sys:String>
  <sys:String x:Key="Label_Language">Language:</sys:String>
  <sys:String x:Key="Button_Recalculate">Recalculate</sys:String>

  <!-- Tabs -->
  <sys:String x:Key="Tab_GoldenRatio">Golden Ratio</sys:String>
  <sys:String x:Key="Tab_Approx">Approximation</sys:String>
  <sys:String x:Key="Tab_PowersOfTwo">Powers of Two</sys:String>

  <!-- Column titles -->
  <sys:String x:Key="Col_Width">Width</sys:String>
  <sys:String x:Key="Col_WidthDec">Width Decrement</sys:String>
  <sys:String x:Key="Col_Height">Height</sys:String>
  <sys:String x:Key="Col_HeightDec">Height Decrement</sys:String>
  <sys:String x:Key="Col_WidthApprox">Width Approx</sys:String>
  <sys:String x:Key="Col_HeightApprox">Height Approx</sys:String>
  <sys:String x:Key="Col_PowersOfTwo">Multiple of Two</sys:String>

  <!-- Status -->
  <sys:String x:Key="Msg_InvalidSpacing">Invalid spacing value</sys:String>
  <sys:String x:Key="Msg_Copied">Copied to clipboard: {0}</sys:String>
</ResourceDictionary>