<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- アプリのアイコンは Assets/app.ico が存在する場合のみ組み込み -->
  <PropertyGroup Condition="Exists('Assets\\app.ico')">
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup Condition="Exists('Assets\\app.ico')">
    <None Include="Assets\app.ico" />
  </ItemGroup>

  <!-- 実行時ウィンドウ用の PNG アイコン（pack URI で参照するためリソースに埋め込み） -->
  <ItemGroup>
    <Resource Include="Assets\app.png" Condition="Exists('Assets\\app.png')" />
  </ItemGroup>

</Project>
