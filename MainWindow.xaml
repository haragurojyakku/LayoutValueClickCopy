<Window x:Class="LayoutValueClickCopy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LayoutValueClickCopy.ViewModels"
        Title="LayoutValueClickCopy" 
        SizeToContent="WidthAndHeight" 
        ResizeMode="NoResize">
    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 入力フィールドと再計算ボタン用の行 -->
            <RowDefinition Height="Auto" />
            <!-- ボタン群の行 -->
            <RowDefinition Height="Auto" />
            <!-- ステータスメッセージ用の行 -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- スペーシング入力欄と再計算ボタン -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource Label_Spacing}" VerticalAlignment="Center" Margin="0,0,5,0" />
            <TextBox Width="100" Margin="0,0,10,0" Text="{Binding SpacingText, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="{DynamicResource Button_Recalculate}" Width="100" Command="{Binding RecalculateCommand}" />
            <TextBlock Text="  {DynamicResource Label_DisplaySet}" VerticalAlignment="Center" Margin="10,0,5,0" />
            <ComboBox Width="140" ItemsSource="{Binding DisplaySets}" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"/>
            <TextBlock Text="  {DynamicResource Label_Language}" VerticalAlignment="Center" Margin="10,0,5,0" />
            <ComboBox Width="120" ItemsSource="{Binding Languages}"
                      DisplayMemberPath="Display"
                      SelectedValuePath="Code"
                      SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}" />
        </StackPanel>

        
        <!-- タブで表示セットを切り替え -->
    <TabControl Grid.Row="1" Margin="5" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <!-- Golden Ratio -->
            <TabItem Header="{DynamicResource Tab_GoldenRatio}">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Width -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="5">
                        <TextBlock Text="{DynamicResource Col_Width}" FontWeight="Bold" FontSize="16" />
                        <ItemsControl ItemsSource="{Binding WidthValues}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}"
                                            Width="100" Height="30" Margin="5" FontSize="16"
                                            Command="{Binding DataContext.CopyValueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Width Decrement -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="5">
                        <TextBlock Text="{DynamicResource Col_WidthDec}" FontWeight="Bold" FontSize="16" />
                        <ItemsControl ItemsSource="{Binding WidthDecrements}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" ContentStringFormat="-{0}"
                                            Width="100" Height="30" Margin="5" FontSize="16"
                                            Command="{Binding DataContext.CopyValueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Height -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="5">
                        <TextBlock Text="{DynamicResource Col_Height}" FontWeight="Bold" FontSize="16" />
                        <ItemsControl ItemsSource="{Binding HeightValues}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}"
                                            Width="100" Height="30" Margin="5" FontSize="16"
                                            Command="{Binding DataContext.CopyValueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Height Decrement -->
                    <StackPanel Grid.Column="3" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="5">
                        <TextBlock Text="{DynamicResource Col_HeightDec}" FontWeight="Bold" FontSize="16" />
                        <ItemsControl ItemsSource="{Binding HeightDecrements}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" ContentStringFormat="-{0}"
                                            Width="100" Height="30" Margin="5" FontSize="16"
                                            Command="{Binding DataContext.CopyValueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Approximation -->
            <TabItem Header="{DynamicResource Tab_Approx}">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Width Approx -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="5">
                        <TextBlock Text="{DynamicResource Col_WidthApprox}" FontWeight="Bold" FontSize="16" />
                        <ItemsControl ItemsSource="{Binding WidthApproxValues}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Display}"
                                            Width="160" Height="30" Margin="5" FontSize="14"
                                            Command="{Binding DataContext.CopyValueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Value}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Height Approx -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="5">
                        <TextBlock Text="{DynamicResource Col_HeightApprox}" FontWeight="Bold" FontSize="16" />
                        <ItemsControl ItemsSource="{Binding HeightApproxValues}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Display}"
                                            Width="160" Height="30" Margin="5" FontSize="14"
                                            Command="{Binding DataContext.CopyValueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Value}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Powers of Two -->
            <TabItem Header="{DynamicResource Tab_PowersOfTwo}">
                <StackPanel Margin="5" VerticalAlignment="Top" HorizontalAlignment="Center">
                    <TextBlock Text="{DynamicResource Col_PowersOfTwo}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding MultipleOfTwoValues}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}"
                                        Width="100" Height="30" Margin="5" FontSize="16"
                                        Command="{Binding DataContext.CopyValueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- ステータスメッセージ用のTextBlock -->
        <TextBlock Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" FontSize="14" Margin="10"
                   Text="{Binding StatusMessage}" Foreground="{Binding StatusBrush}"/>
    </Grid>
</Window>
